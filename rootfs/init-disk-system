#!/bin/sh
# NeurAI Integrated OS - system init (PID 1) for the INSTALLED system.
# Runs from the disk root after the loader's switch_root. Persistent
# state lives on the NEURAI_DATA volume; the integrity volume is the
# ADR-001 gated store (audit, backups, rollback, registry).
/bin/busybox --install -s /bin 2>/dev/null
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
hostname neurai-os 2>/dev/null

if [ -d /neurai/data/home ] || [ -f /neurai/data/.neurai-data ]; then
  export NEURAI_HOME=/neurai/data/home
  export NEURAI_MODEL_PATH=/neurai/data/models/model.gguf
else
  echo "[NeurAI] WARNING: data volume not mounted - state will NOT persist"
  export NEURAI_HOME=/var/lib/neurai
  export NEURAI_MODEL_PATH=/usr/local/lib/neurai/models/model.gguf
fi
export NEURAI_INTEGRITY_DIR=/neurai/integrity
export NEURAI_LLAMA_BIN=/usr/local/lib/neurai/llama/llama-completion
export HOME=/root PATH=/usr/local/bin:/bin:/usr/bin:/sbin:/usr/sbin
mkdir -p "$NEURAI_HOME" /root /tmp /var/log; chmod 1777 /tmp

echo ""
echo "  _   _                      ___ ___ "
echo " | \\ | | ___ _   _ _ __ __ _|_ _/ _ \\"
echo " |  \\| |/ _ \\ | | | '__/ _\` || || | | |"
echo " | |\\  |  __/ |_| | | | (_| || || |_| |"
echo " |_| \\_|\\___|\\__,_|_|  \\__,_|___\\___/ "
echo "  NeurAI Integrated OS v2.0.0 - installed system - local AI is the interface"
echo ""

# Networking (best effort, offline-capable OS)
ip link set lo up 2>/dev/null
for i in eth0 enp0s3 ens33 enp1s0; do ip link set $i up 2>/dev/null; udhcpc -i $i -n -q 2>/dev/null & done

if [ -x /usr/bin/python3 ]; then
  python3 /usr/local/lib/neurai/neurai.py --daemon >>/var/log/neurai-daemon.log 2>&1 &
  python3 /usr/local/lib/neurai/neurai.py --serve 8080 >>/var/log/neurai-web.log 2>&1 &
  echo "[NeurAI] daemon + web console (http://127.0.0.1:8080) started"
  while true; do
    python3 /usr/local/lib/neurai/neurai.py || sleep 2
    echo "[NeurAI] shell restarted (the OS does not exit when the shell does)"
  done
else
  echo "[NeurAI] python3 missing - dropping to busybox shell"
  exec sh
fi
